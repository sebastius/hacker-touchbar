[Unit]
# Verifies the Apple Touch Bar enumerated after boot; retries the apple_bce
# port walk if the ~30% probe race dropped it. Runs once, 20s after boot,
# before or around session start. Deliberately not wanted by tiny-dfr:
# it must also run when the bar is MISSING (tiny-dfr never starts then).
Description=Touch Bar enumeration watchdog
After=multi-user.target

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 20
ExecStart=/usr/local/lib/touchbar-fx/touchbar-watchdog.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
